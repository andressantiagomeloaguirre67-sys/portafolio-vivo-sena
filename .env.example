# ==========================================
# Variables de Entorno - Portafolio Vivo SENA ADSO
# ==========================================

# Django
DEBUG=True
SECRET_KEY=django-insecure-portafolio-vivo-sena-adso-2026-dev-key
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Base de Datos (PostgreSQL 16 + pgvector + pg_trgm)
POSTGRES_DB=portafolio_sena
POSTGRES_USER=sena_user
POSTGRES_PASSWORD=sena_secret_2026
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# MinIO / S3 (Alojamiento único de la versión más reciente por proyecto)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minio_sena_admin
MINIO_ROOT_PASSWORD=minio_sena_password_2026
MINIO_BUCKET_PROYECTOS=proyectos-actuales-sena
SANDBOX_BASE_URL=http://localhost:8088/proyectos

# Google Gemini API (Agente IA Guardián de Originalidad)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Correo Gmail SMTP (Activación de cuentas de aprendices)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
FRONTEND_URL=http://localhost:5173
